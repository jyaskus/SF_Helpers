<?xml version="1.0" encoding="iso-8859-1"?>
<root>

	<windowclass name="popup_npcs">
		<placement>
			<size height="600" width="560" />
		</placement>
      <frame>
      	<name>referenceblock-text1</name>
    	</frame>
		<sheetdata>
        
      <tokenfield name="tNPCicon">
				<frame>
          <name>border</name>
          <offset>2,2,2,2</offset>
      	</frame>
				<bounds>30,45,120,120</bounds>
        <empty>button_char_inv_none</empty>
				<script>
				function onInit()
					local sValue=getValue();
					if sValue == nil or sValue == "" then
						setValue("button_char_inv_none");
					end
				end
				function onDoubleClick()
					setValue("button_char_inv_none");
				end
				</script>
			</tokenfield>

			<formattedtextfield name="npcLinkDropBox">
				<frame name="fieldfocus" offset="10,10,5,5" />
        <bounds>180,70,-180,40</bounds>
				<empty textres="organizations_tooltip_linkNPC" />
				<tooltip textres="organizations_tooltip_linkNPC" />
      </formattedtextfield>
			
			<genericcontrol name="npc_name_frame">
				<frame name="ctentrybox_foe" />
				<bounds>5,10,175,30</bounds>
			</genericcontrol>
			<stringfield name="npc_name">
				<bounds>30,15,150,20</bounds>
				<font>reference-b-large</font>
				<controlline />
				<lineoffset>-2</lineoffset>
			</stringfield>

			<number name="npc_CR">
				<frame name="token_ordinal" />
				<bounds>205,15,30,30</bounds>
				<tooltip textres="detail_npcs_CR_Tooltip" />
				<script>
				function onInit()
					window.rankIconCycler.updateRank();
				end
				</script>
			</number>

			<button_iconcycler name="statusIconCycler">
				<bounds>260,10,40,40</bounds>
				<frame name="border" />
				<parameters>
					<defaulticon>status_001</defaulticon>
					<icons>status_001|status_002|status_003|status_004|status_005|status_006|status_007|status_008|status_009|status_010|status_011|status_012</icons>
					<values>Active|Idle|Deployed|Enroute|Dark|Wounded|Flagged|Recruiting|Tasked|Breifing|Suspended|MIA</values>
					<tooltipsres>tooltip_npc_status_001|tooltip_npc_status_002|tooltip_npc_status_003|tooltip_npc_status_004|tooltip_npc_status_005|tooltip_npc_status_006|tooltip_npc_status_007|tooltip_npc_status_008|tooltip_npc_status_009|tooltip_npc_status_010|tooltip_npc_status_011|tooltip_npc_status_012</tooltipsres>
				</parameters>
			</button_iconcycler>

			<button_iconcycler name="rankIconCycler">
				<bounds>400,20,70,40</bounds>
				<parameters>
					<defaulticon>icon_org_follower</defaulticon>
					<icons>icon_org_follower|icon_org_member|icon_org_officer</icons>
					<values>follower|member|officer</values>
					<tooltipsres>detail_npcs_Label_follower|detail_npcs_Label_member|detail_npcs_Label_officer</tooltipsres>
				</parameters>
				<script>
				function onValueChanged()
				  	updateRank();
				end
				function updateRank()
					local sAction = getStringValue();
					if sAction == nil or sAction == "" then
						sf.DebugOut("rankIconCycler-updateRank: no action selected");
						return;
					end

					if sAction == "officer" then
						window.npc_rank.setValue("3");
					elseif sAction == "member" then
						window.npc_rank.setValue("2");
					else
						window.npc_rank.setValue("1");
					end
				end
				</script>
			</button_iconcycler>

			<stringfield name="npc_rank">
				<bounds>-50,20,20,20</bounds>
				<invisible />
				<script>
				function onInit()
					updateNameFrame();
				end
				function onValueChanged()
				  	updateNameFrame();
				end
				function updateNameFrame()
					local sRank = getValue();
					if sRank == nil or sRank == "" then
						sf.DebugOut("npc_rank: nil");
						return;
					end
					if sRank == "3" then
						window.npc_name_frame.setFrame("ctentrybox_friend");
					elseif sRank == "2" then
						window.npc_name_frame.setFrame("ctentrybox_neutral");
					else
						window.npc_name_frame.setFrame("ctentrybox_foe");
					end
				end
				</script>
			</stringfield>

			<stringfield name="npc_role">
				<bounds>200,120,-200,30</bounds>
				<center />
				<frame name="fielddark" offset="2,2,2,2" />
				<empty textres="detail_npcs_role_empty" />
				<tooltip textres="detail_npcs_role_Tooltip" />
			</stringfield>

			<stringfield name="sDescription">
        <bounds>20,150,-20,30</bounds>
        <center />
				<empty textres="detail_npcs_title_empty" />
			</stringfield>

      <formattedtextfield name="freeText1">
        <bounds>30,180,-25,-20</bounds>
        <empty textres="detail_npcs_desc_empty" />
				<frame name="fielddark" offset="10,10,10,10" />
      </formattedtextfield>

      <buttoncontrol name="closeButton">
        <frame>
        	<name>buttonup</name>
       	</frame>
        <bounds>-28,5,26,26</bounds>
        <state icon="button_toolbar_window_close" />
				<script>
				function onButtonPress()
          window.close();
				end
				</script>
      </buttoncontrol>
    
		</sheetdata>
	</windowclass>
  
</root>
