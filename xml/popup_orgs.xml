<root>

	<windowclass name="popup_orgs">
		<placement>
		  <size height="470" width="470" />
		</placement>
    <sizelimits>
      <minimum width="470" height="470" />
      <dynamic />
    </sizelimits>
    <frame name="referencelist" />
		<sheetdata>

			<windowlist name="list_organizations">
				<frame name="groupbox" offset="5,0,5,0"/>
				<bounds>35,40,-30,-65</bounds>
				<class>detail_orgs</class>
				<datasource>.organization_list</datasource>

				<allowcreate />
        <allowdelete />

        <sortby>
				  <control desc="true">orgLevel</control>
      	  <control>orgName</control>
        </sortby>

        <filter>
          <control>list_filter_orgs</control>
        </filter>
        <filteron>
          <control>orgName</control>
        </filteron>

      </windowlist>
      <scrollbarcontrol name="scrollbar_orgs">
        <bounds>-32,60,20,-75</bounds>
        <frame>
          <name>scrollbar_base</name>
          <offset>0,12,0,12</offset>
        </frame>
        <target>list_organizations</target>
        <normal name="scrollbutton_normal">
          <minimum height="scrollbutton_normal" />
        </normal>
      </scrollbarcontrol>

      <!-- buttons to add or delete records -->
      <buttoncontrol name="addOrgButton">
        <bounds>-90,-60,30,30</bounds>
        <state icon="button_add" />
				<script>
				function onButtonPress()
          local sDBrootPath = "organizations";
          local sOrgListPath = sDBrootPath .. ".organization_list";
          local tNode = DB.createChild(sDBrootPath, "organization_list");
					local ListNode = DB.getChild(sDBrootPath, "organization_list");
					local listCnt = ListNode.getChildCount();

					local nodeList = ListNode.createChild();
				end
				</script>
      </buttoncontrol>
      <buttoncontrol name="editOrgButton">
        <bounds>-60,-60,30,30</bounds>
        <state icon="button_edit" />
        <state icon="button_edit_down" />
				<script>
				function onButtonPress()
          local sDBrootPath = "organizations";
          local sOrgListPath = sDBrootPath .. ".organization_list";
          local tNode = DB.createChild(sDBrootPath, "organization_list");
					local ListNode = DB.getChild(sDBrootPath, "organization_list");
					local listCnt = ListNode.getChildCount();

					local nodeList = ListNode.createChild();
				end
				</script>
      </buttoncontrol>
      <!-- search bar -->
      <stringcontrol name="list_filter_orgs">
        <bounds>60,-60,-100,30</bounds>
        <controlline />
        <lineoffset>-2</lineoffset>
        <frame name="search" offset="30,0,5,0" />
        <tooltip textres="sf_tooltip_search_organizations" />
      </stringcontrol>

      <stringcontrol name="page_orgsTitle">
        <bounds>90,0,-90,30</bounds>
        <center />
        <default textres="sf_main_label_organizations_title" />
        <font>windowtitle</font>
        <frame name="windowtitle" />
				<readonly />
      </stringcontrol>

      <buttoncontrol name="help_button_organization">
				<frame name="buttonup" />
				<bounds>-68,5,26,26</bounds>
				<state icon="button_toolbar_help" />
				<script>
				function onButtonPress()
					local sDBnode = "organizations";
					Interface.openWindow("sf_organization_help_popup", sDBnode);
				end
				</script>
				<tooltip textres="nm_tooltip_help_button" /> 
			</buttoncontrol>

      <buttoncontrol name="closeButton">
      	<frame name="buttonup" />
        <bounds>-28,5,26,26</bounds>
        <state icon="button_toolbar_window_close" />
				<script>
				function onButtonPress()
          window.close();
				end
				</script>
      </buttoncontrol>

      <!-- window_resize -->
      <buttoncontrol name="window_resize_indicator">
        <bounds>-20,-20,20,20</bounds>
        <state icon="window_resize" />
      </buttoncontrol>
    
		</sheetdata>
	</windowclass>

</root>
