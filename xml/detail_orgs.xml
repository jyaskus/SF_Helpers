<root>

	<windowclass name="detail_orgs">
		<placement>
    <size height="45" width="500" />
		</placement>
      <frame name="border" /> <!-- combobox_list   -->
		<sheetdata>

      <number name="orgLevel">
				<bounds>5,10,30,30</bounds>
				<color>#FF000000</color>
				<font>sheetnumber</font>
				<min>1</min>
				<max>20</max>
				<default>1</default>
        <readonly />
				<description textres="sf_organizations_orgLevel_DescriptionText" />
			</number>

      <tokenfield name="tOrgIcon">
				<frame>
					<name>border</name>
          <offset>2,2,2,2</offset>
				</frame>
				<empty>button_char_inv_none</empty>
				<bounds>35,5,35,35</bounds>
				<script>
				function onInit()
					local sValue=getValue();
					if sValue == nil or sValue == "" then
						setValue("button_char_inv_none");
					else
						sf.DebugOut("sVal:" .. sValue);
					end
				end
				function onDoubleClick()
					sf.DebugOut("sVal:" .. getValue() );
					setValue("button_char_inv_none");
				end
				</script>
			</tokenfield>

      <stringfield name="orgName">
        <bounds>70,10,125,20</bounds>
        <center />
        <color>#FF000000</color>
        <font>reference-b-large</font>
				<empty textres="sf_organizations_org_name_default" />
      </stringfield>

            <!-- Followers -->
			<number name="nFollowersCR">
				<bounds>-280,10,25,25</bounds>
        <font>reference-i</font>
				<tooltip textres="sf_organizations_nFollowersCR_Tooltip" />
				<default>0.3</default>
			</number>
			<number name="nFollowers">
				<frame name="fieldlight" />
				<font>sheetnumber</font>
				<bounds>-255,5,35,35</bounds>
				<tooltip textres="sf_organizations_Label_followers_LabelCaption" />
				<default>0</default>
			</number>

            <!-- Members -->
			<number name="nMembersCR">
				<bounds>-210,10,25,25</bounds>
        <font>reference-i</font>
				<tooltip textres="sf_organizations_nMembersCR_Tooltip" />
				<default>0.3</default>
			</number>
			<number name="nMembers">
				<frame name="fieldlight" />
				<!--color>#FF000000</color-->
				<font>sheetnumber</font>
				<bounds>-185,5,35,35</bounds>
				<tooltip textres="sf_organizations_Label_members_LabelCaption" />
				<default>0</default>
			</number>

            <!-- Officers -->
			<number name="nOfficersCR">
				<bounds>-140,10,25,25</bounds>
        <font>reference-i</font>
				<tooltip textres="sf_organizations_nOfficersCR_Tooltip" />
				<default>0.3</default>
			</number>
			<number name="nOfficers">
				<frame name="fieldlight" />
				<!--color>#FF000000</color-->
				<font>sheetnumber</font>
				<bounds>-115,5,35,35</bounds>
				<tooltip textres="sf_organizations_Label_officers_LabelCaption" />
				<default>0</default>
			</number>

			<number name="nOrgPower">
				<frame name="fielddark" />
				<bounds>-75,5,40,40</bounds>
				<min>5</min>
				<max>35</max>
				<default>5</default>
        <displaysign />
        <tooltip textres="sf_orgs_power_tooltip" />
			</number>

      <buttoncontrol name="ButtonExam">
				<bounds>-30,25,20,20</bounds>
				<state icon="button_export" />
				<state icon="button_export_down" />
        <script>
				function onInit()
				 	local sName = window.orgName.getValue();
					if sName == "" or sName == nil then
					  popup();
					end
				end
        function onButtonPress()
				  popup();
				end
				function popup()
					local sDBnode = window.getDatabaseNode();
					Interface.openWindow("sf_organization", sDBnode);
				end
        </script>
      </buttoncontrol>

		</sheetdata>
	</windowclass>

</root>
