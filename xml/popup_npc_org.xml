<?xml version="1.0" encoding="iso-8859-1"?>
<root>

	<windowclass name="npc_org_popup">
    <frame name="referenceblock-text1" />
		<placement>
			<size height="700" width="550" />
		</placement>
		<shareable />
		<sheetdata>

			<buttoncontrol name="button_organization_notes">
				<bounds>25,8,30,30</bounds>
				<state icon="minimized_reference" />
				<script>
				function onButtonPress()
					local sDBnode = window.getDatabaseNode();
					Interface.openWindow("sf_organization_notes_popup", sDBnode);
				end
				</script>
				<tooltip textres="detail_supplies_desc_empty" />
			</buttoncontrol>

			<tokenfield name="tOrgIcon">
				<frame>
					<name>border</name>
					<offset>2,2,2,2</offset>
				</frame>
				<empty>button_char_inv_none</empty>
				<bounds>60,12,60,60</bounds>
				<script>
				function onInit()
					local sValue=getValue();
					if sValue == nil or sValue == "" then
						setValue("button_char_inv_none");
					else
						sf.DebugOut("sVal:" .. sValue);
					end
				end
				function onDoubleClick()
					sf.DebugOut("sVal:" .. getValue() );
					setValue("button_char_inv_none");
				end
				</script>
			</tokenfield>

			<number name="orgLevel">
				<frame name="fieldlight" />
				<bounds>440,55,60,50</bounds>
				<min>1</min>
				<max>20</max>
				<color>#FF000000</color>
				<font>sheetnumber</font>
				<default>1</default>
				<description textres="sf_organizations_orgLevel_DescriptionText" />
				<script>
				function onValueChanged()
					local nLevel = tonumber(window.orgLevel.getValue());
						
					local nFollowers  = sf.ORG_followers(nLevel);
					local nMembers    = sf.ORG_members(nLevel);
					local nMembersCR  = sf.ORG_members_CR(nLevel);
					local nOfficers   = sf.ORG_officers(nLevel);
					local nOfficersCR = sf.ORG_officers_CR(nLevel);
					local nOrgPower   = sf.ORG_power(nLevel);

					window.nFollowersMax.setValue(nFollowers);
					window.nMembersMax.setValue(nMembers);
					window.nMembersCR.setValue(nMembersCR);
					window.nOfficersMax.setValue(nOfficers);
					window.nOfficersCR.setValue(nOfficersCR);
					window.nOrgPower.setValue(nOrgPower);

          nFollowers = 1 + sf.ORG_followers(nLevel-1);
          nMembers   = 1 + sf.ORG_members(nLevel-1);
					local nOfficersMin  = 1 + sf.ORG_officers(nLevel-1);
          if sf.isGt(nOfficersMin,nOfficers) then
            nOfficersMin = nOfficers;
          end

          window.nFollowersMin.setValue(nFollowers);
          window.nMembersMin.setValue(nMembers);
          window.nOfficersMin.setValue(nOfficersMin);
				end
				</script>
			</number>
			<buttoncontrol name="button_level_up">
				<frame name="buttonup" />
				<bounds>500,55,24,24</bounds>
				<icon normal="arrowright" />
				<stateframe>
					<pressed name="buttonup" offset="-1,-1,-1,-1" nobaseframe="true" />
				</stateframe>
				<font>button-white</font>
				<script>
					function onButtonPress()
						local nLevel = tonumber(window.orgLevel.getValue());

						nLevel = nLevel +1;
						if sf.isGt(nLevel,20) then
							nLevel = 20;
						end
						if sf.isGt(1,nLevel) then
							nLevel = 1;
						end
						window.orgLevel.setValue(nLevel);
					end	
				</script>
			</buttoncontrol>
			<buttoncontrol name="button_level_down">
				<frame name="buttonup" />
				<bounds>500,80,24,24</bounds>
				<icon normal="arrowleft" />
				<stateframe>
					<pressed name="buttonup" offset="-1,-1,-1,-1" nobaseframe="true" />
				</stateframe>
				<font>button-white</font>
				<script>
					function onButtonPress()
						local nLevel = tonumber(window.orgLevel.getValue());
						nLevel = nLevel -1;
						if sf.isGt(nLevel,20) then
							nLevel = 20;
						end
						if sf.isGt(1,nLevel) then
							nLevel = 1;
						end
						window.orgLevel.setValue(nLevel);
					end
					
				</script>
			</buttoncontrol>
			<stringcontrol name="label_org_level">
				<bounds>440,30,80,28</bounds>
				<color>#FF000000</color>
				<font>reference-b</font>
				<static textres="sf_organizations_label_org_level_LabelCaption" />
				<readonly />
			</stringcontrol>

      <!-- casual interests 5 to 10x -->
      <number name="nCasualMin">
				<bounds>130,50,60,30</bounds>
        <font>sheetlabelinline</font>
				<tooltip textres="sf_organizations_nCasualMin_Tooltip" />
			</number>
			<number name="nCasualMax">
				<bounds>195,50,60,30</bounds>
        <font>sheetlabelinline</font>
				<tooltip textres="sf_organizations_nCasualMax_Tooltip" />
			</number>

			<!-- followers -->
			<stringcontrol name="Label_followers">
				<bounds>40,85,100,20</bounds>
				<font>reference-b</font>
				<color>#FF000000</color>
				<tooltip textres="sf_organizations_Label_followers_Tooltip" />
				<static textres="sf_organizations_Label_followers_LabelCaption" />
				<readonly />
			</stringcontrol>
			<number name="nFollowersMin">
				<frame name="" />
				<bounds>130,80,60,30</bounds>
        <script>
        function onValueChanged()
          updateCasual();
        end
        function onInit()
          updateCasual();
        end
        function updateCasual()
          local nValue = getValue();
          local nCasualMin = nValue * 5;
          window.nCasualMin.setValue(nCasualMin);
        end
        </script>
				<tooltip textres="sf_organizations_nFollowersMin_Tooltip" />
			</number>
			<number name="nFollowersMax">
				<frame name="" />
				<bounds>195,80,60,30</bounds>
        <script>
        function onValueChanged()
          updateCasual();
        end
        function onInit()
          updateCasual();
        end
        function updateCasual()
          local nValue = getValue();
          local nCasualMax = nValue * 10;
          window.nCasualMax.setValue(nCasualMax);
        end
        </script>
				<tooltip textres="sf_organizations_nFollowersMax_Tooltip" />
			</number>			
			<number name="nFollowersCR">
				<frame name="fielddark" />
				<bounds>260,80,40,30</bounds>
				<tooltip textres="sf_organizations_nFollowersCR_Tooltip" />
				<default>0.33</default>
			</number>
			<number name="nFollowersAdj">
				<color>#FF000000</color>
				<font>sheetnumber</font>
				<frame name="fieldlight" />
				<bounds>310,80,60,30</bounds>
				<tooltip textres="sf_organizations_Label_followers_LabelCaption" />
				<default>0</default>
			</number>
			<number name="nFollowers">
				<bounds>360,80,40,30</bounds>
				<color>#FF000000</color>
				<font>sheetnumber</font>
				<tooltip textres="sf_organizations_followers_named_tooltip" />
				<default>0</default>
				<script>
				function onValueChanged()
					local nAdj = window.nFollowersAdj.getValue();
					local nVal = getValue();
					if nAdj == 0 then
						window.nFollowersAdj.setValue(nVal);
					end
				end
				</script>
			</number>

			<!-- members -->
			<stringcontrol name="Label_members">
				<bounds>40,120,100,20</bounds>
				<font>reference-b</font>
				<color>#FF000000</color>
				<tooltip textres="sf_organizations_Label_members_Tooltip" />
				<static textres="sf_organizations_Label_members_LabelCaption" />
				<readonly />
			</stringcontrol>
			<number name="nMembersMin">
				<frame name="" />
				<bounds>135,115,50,30</bounds>
				<tooltip textres="sf_organizations_nMembersMin_Tooltip" />
			</number>
			<number name="nMembersMax">
				<frame name="" />
				<bounds>200,115,50,30</bounds>
				<tooltip textres="sf_organizations_nMembersMax_Tooltip" />				
			</number>			
			<number name="nMembersCR">
				<frame name="fielddark" />
				<bounds>260,115,40,30</bounds>
				<tooltip textres="sf_organizations_nMembersCR_Tooltip" />
				<default>0.33</default>
        <script>
				function onValueChanged()
					updateTooltip();
				end
				function onInit()
					updateTooltip();
				end
				function updateTooltip()
					local orgLevel = tonumber(window.orgLevel.getValue());
					local sOutput = sf.distributeMembers(orgLevel);
					setTooltipText(sOutput);
				end
				</script>
			</number>
			<number name="nMembersAdj">
				<color>#FF000000</color>
				<font>sheetnumber</font>
				<frame name="fieldlight" />
				<bounds>315,115,50,30</bounds>
				<tooltip textres="sf_organizations_Label_members_LabelCaption" />
				<default>0</default>
			</number>
			<number name="nMembers">
				<bounds>360,115,40,30</bounds>
				<color>#FF000000</color>
				<font>sheetnumber</font>
				<tooltip textres="sf_organizations_members_named_tooltip" />
				<default>0</default>
				<script>
				function onValueChanged()
					local nAdj = window.nMembersAdj.getValue();
					local nVal = getValue();
					if nAdj == 0 then
						window.nMembersAdj.setValue(nVal);
					end
				end
				</script>
			</number>

			<!-- officers -->
			<stringcontrol name="Label_officers">
				<bounds>40,155,100,20</bounds>
				<font>reference-b</font>
				<color>#FF000000</color>
				<tooltip textres="sf_organizations_Label_officers_Tooltip" />
				<static textres="sf_organizations_Label_officers_LabelCaption" />
				<readonly />
			</stringcontrol>
			<number name="nOfficersMin">
				<frame name="" />
				<bounds>140,150,40,30</bounds>
				<tooltip textres="sf_organizations_nOfficersMin_Tooltip" />
			</number>
			<number name="nOfficersMax">
				<frame name="" />
				<bounds>205,150,40,30</bounds>
				<tooltip textres="sf_organizations_nOfficersMax_Tooltip" />				
			</number>			
			<number name="nOfficersCR">
				<frame name="fielddark" />
				<bounds>260,150,40,30</bounds>
				<tooltip textres="sf_organizations_nOfficersCR_Tooltip" />
				<default>0.33</default>
        <script>
				function onValueChanged()
					updateTooltip();
				end
				function onInit()
					updateTooltip();
				end
				function updateTooltip()
					local orgLevel = tonumber(window.orgLevel.getValue());
					local sOutput = sf.distributeOfficers(orgLevel);
					setTooltipText(sOutput);
				end
				</script>
			</number>			
			<number name="nOfficersAdj">
				<color>#FF000000</color>
				<font>sheetnumber</font>
				<frame name="fieldlight" />
				<bounds>320,150,40,30</bounds>
				<tooltip textres="sf_organizations_Label_officers_LabelCaption" />
				<default>0</default>
			</number>
			<number name="nOfficers">
				<bounds>360,150,40,30</bounds>
				<color>#FF000000</color>
				<font>sheetnumber</font>
				<tooltip textres="sf_organizations_officers_named_tooltip" />
				<default>0</default>
				<script>
				function onValueChanged()
					local nAdj = window.nOfficersAdj.getValue();
					local nVal = getValue();
					if nAdj == 0 then
						window.nOfficersAdj.setValue(nVal);
					end
				end
				</script>
			</number>

			<!-- ORG power level -->
			<number name="nOrgPower">
				<frame name="fielddark" />
				<bounds>440,135,60,40</bounds>
				<min>5</min>
				<max>35</max>
				<default>5</default>
        <displaysign />
        <tooltip textres="sf_orgs_power_tooltip" />
			</number>
			<stringcontrol name="Label_power">
				<bounds>421,116,100,20</bounds>
				<color>#FF000000</color>
				<font>reference-b</font>
				<static textres="sf_organizations_Label_power_LabelCaption" />
				<readonly />
			</stringcontrol>

			<!-- ORGs list -->
			<stringfield name="npc_rankFilter">
        <bounds>145,0,-165,40</bounds>
				<invisible />
      </stringfield>
			<windowlist name="list_organizations">
				<frame name="fielddark" offset="-5,5,5,2" />
				<bounds>20,180,-20,-15</bounds>
				<class>detail_npcs</class>
				<datasource>.organizations_list</datasource>
				<allowcreate />
				<allowdelete />

				<filter>
     			<control>npc_rankFilter</control>
    		</filter>
     		<filteron>
   			  <control>npc_rank</control>
        </filteron>

				<sortby>
					<control desc="true">npc_rank</control>
					<control desc="true">npc_CR</control>
					<control>npc_name</control>
				</sortby>
				<script>
				function onListChanged()
					local nRank = window.npc_rankFilter.getValue();
					sf.DebugOut("onListChanged: " .. nRank);

					local nWindows = getWindowCount();
					sf.DebugOut("nWindows: " .. nWindows);

					window.npc_rankFilter.setValue("3");
					nWindows = getWindowCount(true);
					sf.DebugOut("nRank 3: " .. nWindows);
					window.nOfficers.setValue(nWindows);

					window.npc_rankFilter.setValue("2");
					nWindows = getWindowCount(true);
					sf.DebugOut("nRank 2: " .. nWindows);
					window.nMembers.setValue(nWindows);

					window.npc_rankFilter.setValue("1");
					nWindows = getWindowCount(true);
					sf.DebugOut("nRank 1: " .. nWindows);
					window.nFollowers.setValue(nWindows);

					-- reset to nil
					window.npc_rankFilter.setValue();
				end
				</script>
			</windowlist>
      <scrollbarcontrol name="scrollbar_orgs">
        <bounds>-26,200,20,-35</bounds>
        <frame>
          <name>scrollbar_base</name>
          <offset>0,12,0,12</offset>
        </frame>
        <target>list_organizations</target>
        <normal name="scrollbutton_normal">
          <minimum height="scrollbutton_normal" />
        </normal>
      </scrollbarcontrol>

			<stringfield name="orgName">
        <bounds>145,0,-165,30</bounds>
				<center />
        <font>windowtitle</font>
				<frame>
        	<name>windowtitle</name>
        </frame>
        <empty textres="sf_organizations_org_name_default" />
      </stringfield>

      <buttoncontrol name="help_orgs_button_dt">
				<bounds>-68,2,26,26</bounds>
        <frame name="buttonup" />				
				<font>button-white</font>
        <state icon="help_button" />
				<state icon="help_button_down" />
				<script>
				function onButtonPress()
					local sDBnode = "organizations";
					Interface.openWindow("sf_organization_orgs_help_popup", sDBnode);
				end
				</script>
				<tooltip textres="gt_tooltip_help_button" /> 
			</buttoncontrol>

      <buttoncontrol name="closeButton">
        <frame name="buttonup" />
        <bounds>-28,2,26,26</bounds>
        <state icon="button_toolbar_window_close" />
        <script>
        function onButtonPress()
          window.close();
        end
        </script>
      </buttoncontrol>

		</sheetdata>
	</windowclass>
  
	<windowclass name="sf_organization_orgs_help_popup">
		<frame>referenceblock-text1</frame>
    	<placement>
      <size width="560" height="700" />
    	</placement>
    	<sizelimits>
      	<minimum width="560" height="700" />
    	</sizelimits>
  		<sheetdata>

			<formattedtextfield name="organization_org_text_help_notes">
				<bounds>25,15,-25,-10</bounds>
				<empty textres="label_organization_notes_text" />
				<script>
				function onInit()
					setValue( OrganizationData.getSF_organization_help_text() );
				end
				</script>
				<readonly />
			</formattedtextfield>

			<buttoncontrol name="SourceBook">
      	<frame>
      		<name>buttonup</name>
       	</frame>
      	<bounds>-50,0,20,20</bounds>
        <state icon="module_loaded" />
				<script>
				function onInit()
			    local sSource = "Galaxy Exploration Manual 2021";
					local sTooltip = "Starfinder " .. sSource .. ", Paizo Inc.";
					setTooltipText(sTooltip);
				end
				</script>
      </buttoncontrol>

			<buttoncontrol name="closeButton">
				<frame>
					<name>buttonup</name>
				</frame>
				<bounds>-20,0,20,20</bounds>
				<state icon="close_button" />
				<script>
				function onButtonPress()
					window.close();
				end
				</script>
			</buttoncontrol>

  		</sheetdata>
	</windowclass>

	<windowclass name="sf_organization_help_popup">
		<frame>referenceblock-text1</frame>
    	<placement>
      	<size width="560" height="700" />
    	</placement>
    	<sizelimits>
      	<minimum width="560" height="700" />
    	</sizelimits>
  		<sheetdata>

			<formattedtextfield name="organization_text_help_notes">
				<bounds>25,15,-25,-10</bounds>
				<empty textres="label_organization_notes_text" />
				<script>
				function onInit()
					setValue( OrganizationData.getLeadershipText() );
				end
				</script>
				<readonly />
			</formattedtextfield>

			<buttoncontrol name="SourceBook">
        <frame>
          <name>buttonup</name>
       	</frame>
        <bounds>-50,0,20,20</bounds>
        <state icon="module_loaded" />
				<script>
				function onInit()
				  local sSource = "Galaxy Exploration Manual 2021";
					local sTooltip = "Starfinder " .. sSource .. ", Paizo Inc.";
					setTooltipText(sTooltip);
				end
				</script>
      </buttoncontrol>

			<buttoncontrol name="closeButton">
				<frame>
					<name>buttonup</name>
				</frame>
				<bounds>-20,0,20,20</bounds>
				<state icon="close_button" />
				<script>
				function onButtonPress()
					window.close();
				end
				</script>
			</buttoncontrol>

  		</sheetdata>
	</windowclass>

	<windowclass name="sf_organization_notes_popup">
		<frame>referenceblock-text1</frame>
    	<placement>
      	<size width="560" height="700" />
    	</placement>
    	<sizelimits>
      	<minimum width="560" height="700" />
    	</sizelimits>
  		<sheetdata>

			<formattedtextfield name="organization_text_orgNotes">
				<bounds>15,20,-20,-15</bounds>
				<frame name="fielddark" offset="10,10,10,10" />
				<empty textres="detail_npcs_desc_empty" />
			</formattedtextfield>

			<buttoncontrol name="closeButton">
				<frame>
					<name>buttonup</name>
				</frame>
				<bounds>-30,10,20,20</bounds>
				<state icon="close_button" />
				<script>
				function onButtonPress()
					window.close();
				end
				</script>
			</buttoncontrol>

  		</sheetdata>
	</windowclass>

</root>